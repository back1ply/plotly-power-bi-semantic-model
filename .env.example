# ── Azure AD / Power BI credentials (required) ───────────────────────────────
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-client-secret-value
WORKSPACE_ID=your-power-bi-workspace-id
DATASET_ID=your-power-bi-dataset-id
REPORT_ID=your-power-bi-report-id

# ── White-label theming (optional) ───────────────────────────────────────────
APP_TITLE=Sales Dashboard
PRIMARY_COLOR=blue
FONT_FAMILY='Inter', sans-serif

# ── Cache (optional) ─────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600
USE_DISK_CACHE=false
CACHE_DIR=./.cache
PRELOAD_DATA=false

# ── API / rate limiting (optional) ───────────────────────────────────────────
PBI_API_BASE=https://api.powerbi.com/v1.0/myorg
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ── Startup resilience (optional) ────────────────────────────────────────────
STARTUP_RETRY_MAX=3
STARTUP_RETRY_DELAY=2.0

# ── Development (optional) ───────────────────────────────────────────────────
FLASK_DEBUG=false
DAX_PATH=./queries/dax.json
